# OpenAI-compatible model endpoint used by the Strands agent (any provider works)
OPENAI_BASE_URL=https://api.inference.wandb.ai/v1
OPENAI_API_KEY=
OPENAI_MODEL=Qwen/Qwen3.8-27B

# HMAC secret for OAuth codes and access tokens (any long random string)
SAGA_SIGNING_SECRET=

# Optional: private Vercel Blob store for family profiles. Without it, profiles are saved to .data/
BLOB_READ_WRITE_TOKEN=
